{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlinkEnvelope",
  "type": "object",
  "required": [
    "version",
    "id",
    "type",
    "sentAt",
    "sourceDeviceId",
    "targetDeviceId",
    "requiresAck",
    "payload"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "pairing.offer",
        "pairing.confirm",
        "device.status",
        "call.ringing",
        "call.ended",
        "message.received",
        "message.reply",
        "clipboard.updated",
        "file.offer",
        "file.accept",
        "file.chunk",
        "file.progress",
        "file.complete",
        "file.result",
        "file.cancel",
        "screen.request",
        "screen.state",
        "screen.pull",
        "screen.frame",
        "screen.idle",
        "screen.stop",
        "web.open",
        "media.state",
        "media.command",
        "permission.state",
        "ack",
        "error",
        "reconnect.hello",
        "reconnect.challenge",
        "reconnect.proof",
        "reconnect.reverse",
        "reconnect.reverse_proof",
        "reconnect.ready",
        "reconnect.commit",
        "reconnect.done"
      ]
    },
    "sentAt": {
      "type": "string"
    },
    "sourceDeviceId": {
      "type": "string",
      "minLength": 1
    },
    "targetDeviceId": {
      "type": "string",
      "minLength": 1
    },
    "requiresAck": {
      "type": "boolean"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reconnectNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "reconnectEndpoint": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2}):45731$"
    },
    "reconnectCommon": {
      "type": "object",
      "required": ["v", "m", "mac", "phone"],
      "properties": {
        "v": {"type": "integer", "const": 1},
        "m": {"$ref": "#/$defs/reconnectNonce"},
        "mac": {"$ref": "#/$defs/reconnectEndpoint"},
        "phone": {"$ref": "#/$defs/reconnectEndpoint"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"pattern": "^reconnect\\."}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "sentAt": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "sourceDeviceId": {"maxLength": 128},
          "targetDeviceId": {"maxLength": 128},
          "requiresAck": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.hello"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "unevaluatedProperties": false}}}
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.challenge"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "required": ["p"], "properties": {"p": {"$ref": "#/$defs/reconnectNonce"}}, "unevaluatedProperties": false}}}
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.proof"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "required": ["p"], "properties": {"p": {"$ref": "#/$defs/reconnectNonce"}}, "unevaluatedProperties": false}}}
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.reverse"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "required": ["p", "r"], "properties": {"p": {"$ref": "#/$defs/reconnectNonce"}, "r": {"$ref": "#/$defs/reconnectNonce"}}, "unevaluatedProperties": false}}}
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.reverse_proof"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "required": ["p", "r"], "properties": {"p": {"$ref": "#/$defs/reconnectNonce"}, "r": {"$ref": "#/$defs/reconnectNonce"}}, "unevaluatedProperties": false}}}
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.ready"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "required": ["p", "r"], "properties": {"p": {"$ref": "#/$defs/reconnectNonce"}, "r": {"$ref": "#/$defs/reconnectNonce"}}, "unevaluatedProperties": false}}}
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.commit"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "required": ["p", "r"], "properties": {"p": {"$ref": "#/$defs/reconnectNonce"}, "r": {"$ref": "#/$defs/reconnectNonce"}}, "unevaluatedProperties": false}}}
    },
    {
      "if": {"properties": {"type": {"const": "reconnect.done"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"allOf": [{"$ref": "#/$defs/reconnectCommon"}], "required": ["p", "r"], "properties": {"p": {"$ref": "#/$defs/reconnectNonce"}, "r": {"$ref": "#/$defs/reconnectNonce"}}, "unevaluatedProperties": false}}}
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^screen\\."
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "sourceDeviceId": {
            "maxLength": 128
          },
          "targetDeviceId": {
            "maxLength": 128
          },
          "requiresAck": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "screen.request"}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["v", "requestId", "profile"],
            "properties": {
              "v": {"const": 1},
              "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "profile": {"const": "jpeg-1280-2fps-v1"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "screen.state"}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "required": ["v", "requestId", "state"],
                "properties": {
                  "v": {"const": 1},
                  "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
                  "state": {"const": "needs_consent"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["v", "requestId", "state", "streamId", "profile"],
                "properties": {
                  "v": {"const": 1},
                  "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
                  "state": {"const": "started"},
                  "streamId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
                  "profile": {"const": "jpeg-1280-2fps-v1"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["v", "requestId", "state", "reason"],
                "properties": {
                  "v": {"const": 1},
                  "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
                  "state": {"const": "rejected"},
                  "reason": {"enum": ["denied", "disabled", "unsupported", "busy", "not_ready", "timeout", "capture_error"]}
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "screen.pull"}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["v", "requestId", "streamId", "index"],
            "properties": {
              "v": {"const": 1},
              "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "streamId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "index": {"type": "integer", "minimum": 1, "maximum": 2147483647}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "screen.idle"}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["v", "requestId", "streamId", "index", "reason"],
            "properties": {
              "v": {"const": 1},
              "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "streamId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "index": {"type": "integer", "minimum": 1, "maximum": 2147483647},
              "reason": {"enum": ["no_new_frame", "frame_too_large"]}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "screen.frame"}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["v", "requestId", "streamId", "index", "width", "height", "data"],
            "properties": {
              "v": {"const": 1},
              "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "streamId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "index": {"type": "integer", "minimum": 1, "maximum": 2147483647},
              "width": {"type": "integer", "minimum": 1, "maximum": 1280},
              "height": {"type": "integer", "minimum": 1, "maximum": 1280},
              "data": {"type": "string", "maxLength": 54616}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "screen.stop"}},
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["v", "requestId", "reason"],
            "properties": {
              "v": {"const": 1},
              "requestId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "streamId": {"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "reason": {"enum": ["user", "disabled", "locked", "hidden", "disconnected", "timeout", "consent_revoked", "capture_error", "protocol_error"]}
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
